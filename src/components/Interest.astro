<script>
    function updateAge() {
        const ageElement = document.querySelector("#age");
        const birthDate = new Date(2001, 4, 10); // May is month 4 (0-indexed)
        const today = new Date();
        let age = today.getFullYear() - birthDate.getFullYear();
        const monthDifference = today.getMonth() - birthDate.getMonth();

        if (
            monthDifference < 0 ||
            (monthDifference === 0 && today.getDate() < birthDate.getDate())
        ) {
            age--;
        }

        if (ageElement) ageElement.textContent = String(age);
    }

    function initializeAboutText() {
        const collapsedText = document.querySelector<HTMLElement>(
            ".about-text-collapsed",
        );
        const textButton = document.querySelector<HTMLElement>(
            ".about-text-button",
        );

        if (!collapsedText || !textButton) return;

        function toggleAboutText() {
            const isExpanded =
                textButton?.getAttribute("aria-expanded") === "true";
            const nextExpandedState = !isExpanded;

            collapsedText?.classList.toggle(
                "is-visible",
                nextExpandedState,
            );
            textButton?.setAttribute(
                "aria-expanded",
                String(nextExpandedState),
            );
            if (textButton) {
                textButton.textContent = nextExpandedState
                    ? "Read Less"
                    : "Read More";
            }
        }

        textButton.addEventListener("click", toggleAboutText);
        textButton.addEventListener("keydown", (event) => {
            if (event.key !== "Enter" && event.key !== " ") return;

            event.preventDefault();
            toggleAboutText();
        });
    }

    updateAge();
    initializeAboutText();
</script>