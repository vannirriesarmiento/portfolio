---
import Heading from "./Heading.astro";
import Review from "./Review.astro";
import Modal from "./Modal.astro";
import "../styles/reviews.css";

import nikita from "../assets/img/reviews/nikita.webp";
import bernel from "../assets/img/reviews/bernel.webp";
import joseph from "../assets/img/reviews/joseph.webp";
import spinnerIcon from "../assets/img/spinner.svg";

const reviews = [
    {
        name: "Nikita Stadnik",
        position: "Head of IT, BSO Real Estate Management LLC",
        review: "Working with Van Sarmiento for two years at BSO Real Estate Management was a great experience. She transformed our product vision into modern, intuitive designs, including our Webflow website, 1,194 mobile app screens, 241 client portal screens, and several supporting products. Van worked quickly, handled feedback professionally, and consistently delivered high-quality work on time. Her dedication and creativity made her an invaluable part of our team.",
        avatar: nikita,
    },
    {
        name: "Bernel Diaz",
        position: "Freelance UI/UX Designer",
        review: `Van and I worked together at university and during our internship. I worked as a UI/UX designer, she worked as a developer.\n\nShe is an excellent collaborator. She communicates clearly, solves problems fast, and brings strong technical skill to every project. I still turn to her for professional guidance today. I recommend her without hesitation.`,
        avatar: bernel,
    },
    {
        name: "Joseph Cedeño",
        position: "Software Engineer, Nuxify",
        review: "It has been a privilege to collaborate with Vannirrie. Her profound knowledge and expertise in her field are truly commendable. Vannirrie consistently delivers exceptional work, demonstrating her commitment to excellence. Her remarkable ability to grasp new concepts swiftly makes working with her on projects a seamless and efficient experience. Vannirrie is an invaluable asset to our team, and I highly recommend her for any future endeavors",
        avatar: joseph,
    },
];
---

<div class="modal-body reviews" id="reviews">
    <Heading
        >nice things people<span class="mobile-break"> </span>have said about me</Heading
    >
    <section class="splide reviews-carousel" aria-label="Testimonials">
        <div class="splide__track">
            <ul class="splide__list">
                {
                    reviews.map((review) => (
                        <li class="splide__slide">
                            <Review {...review} />
                        </li>
                    ))
                }
            </ul>
        </div>
    </section>

    <section class="freedom-wall" data-freedom-wall>
        <Heading>FREEDOM WALL</Heading>

        <div class="postit-notes-grid">
            <div class="freedom-wall-composer">
                <button
                    type="button"
                    class="postit-button"
                    aria-haspopup="dialog"
                    aria-controls="add-note"
                >
                    <span
                        class="material-symbols-outlined"
                        data-wall-add-icon
                        data-spinner-src={spinnerIcon.src}
                        aria-hidden="true">add_2</span
                    >
                    <span>Add a note</span>
                </button>

                <Modal id="add-note" title="Add Note">
                    <div class="postit-note grey freedom-wall-paper">
                        <div class="postit-note-body freedom-wall-form-body">
                            <form
                                id="freedom-wall-form"
                                class="freedom-wall-form"
                                data-wall-form
                            >
                                <div class="freedom-wall-name-row">
                                    <span aria-hidden="true">—</span>
                                    <input
                                        type="text"
                                        name="name"
                                        placeholder="Enter your name here"
                                        required
                                        maxlength="40"
                                        autocomplete="name"
                                        aria-label="Your name"
                                    />
                                    <span data-wall-character-count
                                        >0 / 150</span
                                    >
                                </div>
                                <div class="freedom-wall-message-field">
                                    <textarea
                                        name="message"
                                        placeholder="Type your message here..."
                                        required
                                        maxlength="150"
                                        rows="4"
                                        aria-label="Your message"></textarea>
                                </div>
                                <button
                                    type="submit"
                                    class="freedom-wall-submit"
                                    data-wall-submit
                                    aria-label="Publish note"
                                >
                                    <span class="material-symbols-outlined">
                                        check
                                    </span>
                                </button>
                            </form>
                        </div>
                    </div>
                </Modal>
            </div>
            <div
                class="postit-note none"
                data-wall-empty
                role="status"
                aria-live="polite"
                hidden
            >
                <div class="postit-note-body">
                    <div
                        class="flex w-full flex-1 flex-col items-center justify-center gap-0.5 text-center"
                    >
                        <span
                            class="material-symbols-outlined"
                            style="font-variation-settings: 'FILL' 1; font-size: 4rem; line-height: 6rem;"
                        >
                            sentiment_sad
                        </span>
                        <p>No notes yet.</p>
                        <p>Be the first one to add.</p>
                    </div>
                </div>
            </div>
            <div class="freedom-wall-notes" data-wall-notes></div>
        </div>

        <template data-wall-note-template>
            <article class="postit-note freedom-wall-note" data-wall-note>
                <button
                    type="button"
                    class="postit-delete"
                    data-wall-delete
                    aria-label="Delete your note"
                >
                    <span
                        class="material-symbols-outlined"
                        aria-hidden="true"
                        style="font-variation-settings: 'FILL' 1; font-size: 1.25rem;"
                    >
                        delete
                    </span>
                </button>
                <div class="postit-note-body">
                    <p class="freedom-wall-message" data-wall-message></p>
                    <p class="freedom-wall-author" data-wall-author></p>
                </div>
            </article>
        </template>
    </section>
</div>

<script>
    import {
        addDoc,
        collection,
        deleteDoc,
        doc,
        limit,
        onSnapshot,
        orderBy,
        query,
        serverTimestamp,
    } from "firebase/firestore";
    import {
        ensureAnonymousUser,
        firestore,
        initializeFirebaseAnalytics,
        logFreedomWallEvent,
    } from "../lib/firebase";
    import { showToast } from "../lib/toast";

    type FreedomWallNote = {
        id: string;
        name: string;
        message: string;
        authorUid: string;
    };

    const NOTE_LIMIT = 50;
    const MESSAGE_LIMIT = 150;
    const POST_COOLDOWN_MS = 30_000;
    const LAST_POST_KEY = "freedom-wall:last-posted-at";

    void initializeFirebaseAnalytics();

    document
        .querySelectorAll<HTMLElement>("[data-freedom-wall]")
        .forEach((wall) => {
            const form =
                wall.querySelector<HTMLFormElement>("[data-wall-form]");
            const addNoteButton =
                wall.querySelector<HTMLButtonElement>(".postit-button");
            const addButtonIcon = wall.querySelector<HTMLElement>(
                "[data-wall-add-icon]",
            );
            const submitButton =
                wall.querySelector<HTMLButtonElement>("[data-wall-submit]");
            const nameInput = form?.elements.namedItem("name");
            const messageInput = form?.elements.namedItem("message");
            const characterCount = wall.querySelector<HTMLElement>(
                "[data-wall-character-count]",
            );
            const notesContainer =
                wall.querySelector<HTMLElement>("[data-wall-notes]");
            const noteTemplate = wall.querySelector<HTMLTemplateElement>(
                "[data-wall-note-template]",
            );
            const emptyState =
                wall.querySelector<HTMLElement>("[data-wall-empty]");
            const addNoteDialog = wall.querySelector<HTMLElement>("#add-note");

            if (
                !form ||
                !addNoteButton ||
                !addButtonIcon ||
                !submitButton ||
                !(nameInput instanceof HTMLInputElement) ||
                !(messageInput instanceof HTMLTextAreaElement) ||
                !characterCount ||
                !notesContainer ||
                !noteTemplate ||
                !emptyState ||
                !addNoteDialog
            ) {
                return;
            }

            const wallForm: HTMLFormElement = form;
            const addButton: HTMLButtonElement = addNoteButton;
            const addIcon: HTMLElement = addButtonIcon;
            const postButton: HTMLButtonElement = submitButton;
            const nameField: HTMLInputElement = nameInput;
            const messageField: HTMLTextAreaElement = messageInput;
            const countLabel: HTMLElement = characterCount;
            const noteList: HTMLElement = notesContainer;
            const template: HTMLTemplateElement = noteTemplate;
            const emptyNote: HTMLElement = emptyState;

            let hasStarted = false;
            let currentUid: string | null = null;
            let visibleNotes: FreedomWallNote[] = [];
            const noteColors = new Map<string, "pink" | "grey">();
            const spinnerSrc = addIcon.dataset.spinnerSrc ?? "";
            let spinnerElement: HTMLImageElement | null = null;

            function setNotesLoading(isLoading: boolean) {
                addButton.setAttribute("aria-busy", String(isLoading));

                if (isLoading) {
                    if (spinnerElement) return;

                    const spinner = document.createElement("img");
                    spinner.src = spinnerSrc;
                    spinner.className = "postit-spinner";
                    spinner.alt = "";
                    spinner.width = 32;
                    spinner.height = 32;
                    addIcon.replaceWith(spinner);
                    spinnerElement = spinner;
                } else if (spinnerElement) {
                    spinnerElement.replaceWith(addIcon);
                    spinnerElement = null;
                }
            }

            function getNoteColor(noteId: string): "pink" | "grey" {
                const existingColor = noteColors.get(noteId);
                if (existingColor) return existingColor;

                const color = Math.random() < 0.5 ? "pink" : "grey";
                noteColors.set(noteId, color);
                return color;
            }

            function getCooldownRemaining() {
                try {
                    const lastPostTime = Number(
                        window.localStorage.getItem(LAST_POST_KEY),
                    );
                    if (!Number.isFinite(lastPostTime)) return 0;
                    return Math.max(
                        0,
                        POST_COOLDOWN_MS - (Date.now() - lastPostTime),
                    );
                } catch {
                    return 0;
                }
            }

            function savePostTime() {
                try {
                    window.localStorage.setItem(
                        LAST_POST_KEY,
                        String(Date.now()),
                    );
                } catch {
                    // Posting still works when browser storage is unavailable.
                }
            }

            function renderNotes() {
                const fragment = document.createDocumentFragment();

                visibleNotes.forEach((note) => {
                    const noteFragment = template.content.cloneNode(true);
                    if (!(noteFragment instanceof DocumentFragment)) return;

                    const noteElement =
                        noteFragment.querySelector<HTMLElement>(
                            "[data-wall-note]",
                        );
                    const messageElement =
                        noteFragment.querySelector<HTMLElement>(
                            "[data-wall-message]",
                        );
                    const noteBody =
                        noteFragment.querySelector<HTMLElement>(
                            ".postit-note-body",
                        );
                    const authorElement =
                        noteFragment.querySelector<HTMLElement>(
                            "[data-wall-author]",
                        );
                    const deleteButton =
                        noteFragment.querySelector<HTMLButtonElement>(
                            "[data-wall-delete]",
                        );

                    if (
                        !noteElement ||
                        !messageElement ||
                        !noteBody ||
                        !authorElement ||
                        !deleteButton
                    )
                        return;

                    noteElement.dataset.noteId = note.id;
                    noteBody.classList.add(getNoteColor(note.id));
                    messageElement.textContent = note.message;
                    authorElement.textContent = `— ${note.name}`;

                    if (note.authorUid !== currentUid) {
                        deleteButton.remove();
                    } else {
                        deleteButton.addEventListener("click", async () => {
                            deleteButton.disabled = true;
                            try {
                                const user = await ensureAnonymousUser();
                                if (user.uid !== note.authorUid) {
                                    throw new Error(
                                        "This note belongs to another visitor.",
                                    );
                                }

                                await deleteDoc(
                                    doc(firestore, "freedomWallNotes", note.id),
                                );
                                visibleNotes = visibleNotes.filter(
                                    (visibleNote) => visibleNote.id !== note.id,
                                );
                                renderNotes();
                                showToast({
                                    message: "Post It Deleted!",
                                    variant: "deleted",
                                });
                                void logFreedomWallEvent(
                                    "freedom_wall_note_deleted",
                                );
                            } catch (error) {
                                console.error(
                                    "Unable to delete Freedom Wall note",
                                    error,
                                );
                                showToast({
                                    message:
                                        "We couldn't delete that note. Please try again.",
                                    variant: "error",
                                });
                                deleteButton.disabled = false;
                            }
                        });
                    }

                    fragment.append(noteFragment);
                });

                noteList.replaceChildren(fragment);
            }

            function startNotesListener() {
                setNotesLoading(true);
                emptyNote.hidden = true;
                const notesQuery = query(
                    collection(firestore, "freedomWallNotes"),
                    orderBy("createdAt", "desc"),
                    limit(NOTE_LIMIT),
                );

                onSnapshot(
                    notesQuery,
                    (snapshot) => {
                        visibleNotes = snapshot.docs.flatMap((noteDocument) => {
                            const data = noteDocument.data();
                            if (
                                typeof data.name !== "string" ||
                                typeof data.message !== "string" ||
                                typeof data.authorUid !== "string"
                            ) {
                                return [];
                            }

                            return [
                                {
                                    id: noteDocument.id,
                                    name: data.name,
                                    message: data.message,
                                    authorUid: data.authorUid,
                                },
                            ];
                        });

                        setNotesLoading(false);
                        renderNotes();
                        emptyNote.hidden = visibleNotes.length > 0;
                    },
                    (error) => {
                        setNotesLoading(false);
                        console.error(
                            "Unable to load Freedom Wall notes",
                            error,
                        );
                        showToast({
                            message:
                                "We couldn't load the Freedom Wall. Please try again later.",
                            variant: "error",
                        });
                    },
                );
            }

            async function startWall() {
                if (hasStarted) return;
                hasStarted = true;
                startNotesListener();

                try {
                    currentUid = (await ensureAnonymousUser()).uid;
                    renderNotes();
                } catch (error) {
                    console.error(
                        "Unable to start anonymous Firebase authentication",
                        error,
                    );
                    showToast({
                        message:
                            "Posting is unavailable right now. Please try again later.",
                        variant: "error",
                    });
                }
            }

            messageField.addEventListener("input", () => {
                countLabel.textContent = `${messageField.value.length} / ${MESSAGE_LIMIT}`;
            });

            wallForm.addEventListener("submit", async (event) => {
                event.preventDefault();

                const name = nameField.value.trim();
                const message = messageField.value.trim();
                nameField.value = name;
                messageField.value = message;

                if (
                    !name ||
                    !message ||
                    name.length > 40 ||
                    message.length > MESSAGE_LIMIT
                ) {
                    showToast({
                        message: `Enter your name and a note of up to ${MESSAGE_LIMIT} characters.`,
                        variant: "error",
                    });
                    wallForm.reportValidity();
                    return;
                }

                const cooldownRemaining = getCooldownRemaining();
                if (cooldownRemaining > 0) {
                    showToast({
                        message: `Please wait ${Math.ceil(cooldownRemaining / 1000)} seconds before posting again.`,
                        variant: "info",
                    });
                    return;
                }

                postButton.disabled = true;

                try {
                    const user = await ensureAnonymousUser();
                    currentUid = user.uid;

                    await addDoc(collection(firestore, "freedomWallNotes"), {
                        name,
                        message,
                        authorUid: user.uid,
                        createdAt: serverTimestamp(),
                    });

                    savePostTime();
                    wallForm.reset();
                    countLabel.textContent = `0 / ${MESSAGE_LIMIT}`;
                    showToast({
                        message: "Post It Published!",
                        variant: "success",
                    });
                    addNoteDialog
                        .querySelector<HTMLButtonElement>(".modal-close")
                        ?.click();
                    void logFreedomWallEvent("freedom_wall_note_created");
                } catch (error) {
                    console.error("Unable to create Freedom Wall note", error);
                    showToast({
                        message:
                            "We couldn't post your note. Please try again.",
                        variant: "error",
                    });
                } finally {
                    postButton.disabled = false;
                }
            });

            addNoteDialog.addEventListener("modal:open", () => {
                requestAnimationFrame(() => messageField.focus());
            });

            const modal = wall.closest<HTMLElement>(".modal");
            if (modal) {
                modal.addEventListener("modal:open", () => void startWall(), {
                    once: true,
                });
                if (modal.classList.contains("is-open")) void startWall();
            } else {
                void startWall();
            }
        });
</script>

<script>
    import Splide from "@splidejs/splide";

    function mountReviews(root: ParentNode = document) {
        root.querySelectorAll<HTMLElement>(
            ".reviews-carousel:not(.is-initialized)",
        ).forEach((carousel) => {
            if (carousel.closest(".modal:not(.is-open)")) return;

            const reviewCards = Array.from(
                carousel.querySelectorAll<HTMLElement>(".testimonial-note"),
            );
            const pinkCardIndex = Math.floor(
                Math.random() * reviewCards.length,
            );

            reviewCards.forEach((card, index) => {
                card.classList.toggle("pink", index === pinkCardIndex);
                card.classList.toggle("grey", index !== pinkCardIndex);
            });

            new Splide(carousel, {
                type: "loop",
                perPage: 2,
                gap: "16px",
                arrows: false,
                drag: true,
                pagination: true,
                keyboard: "global",
                speed: 550,
                breakpoints: {
                    992: { gap: "8px" },
                    480: { perPage: 1 },
                },
            }).mount();
        });
    }

    mountReviews();

    document.addEventListener("modal:open", (event) => {
        if (event.target instanceof HTMLElement) {
            requestAnimationFrame(() =>
                mountReviews(event.target as HTMLElement),
            );
        }
    });
</script>
