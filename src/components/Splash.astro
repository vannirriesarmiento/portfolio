---
import "../styles/splash.css";
---
		<div
			id="splash"
			class="splash"
			aria-label="Loading portfolio"
			fs-scrolldisable-element="when-visible"
		>
			<div class="splash-background" aria-hidden="true"></div>
			<div class="splash-wipe" aria-hidden="true">
				<span></span>
				<span></span>
				<span></span>
				<span></span>
				<span></span>
				<span></span>
			</div>
			<div class="splash-content">
				<div id="typing" class="bubble last">
					<div class="loading">
						<div class="dot one"></div>
						<div class="dot two"></div>
						<div class="dot three"></div>
					</div>
				</div>
				<div class="bubble">👋🏻 Hey, it’s Van.</div>
				<div class="bubble last">Welcome to my DeskFolio!</div>
			</div>
		</div>