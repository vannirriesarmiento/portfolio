---
import "animate.css";

interface Props {
    id: string;
    title: string;
}

const { id, title } = Astro.props;
---

<div
    id={id}
    class="modal animate__animated"
    role="dialog"
    aria-label={title}
    aria-modal="true"
    aria-hidden="true"
    fs-scrolldisable-element="when-visible"
>
    <button type="button" class="modal-close" aria-label={`Close ${title}`}>
        <span class="material-symbols-outlined" aria-hidden="true" style="font-variation-settings: 'FILL' 1; font-size: 1.5rem;">
            close
        </span>
    </button>
    <div class="modal-content">
        <slot />
    </div>
</div>

<script>
    const entranceAnimation = "animate__fadeIn";
    const exitAnimation = "animate__fadeOut";
    const animationFallbackDuration = 500;
    const modalTriggers = document.querySelectorAll<HTMLElement>(
        '[aria-haspopup="dialog"][aria-controls]',
    );
    const openingTriggers = new WeakMap<HTMLElement, HTMLElement>();
    const mobileViewportQuery = window.matchMedia("(max-width: 480px)");
    let viewportSyncFrame = 0;

    function clearModalVisualViewport(modal: HTMLElement) {
        modal.style.removeProperty("--modal-visual-top");
        modal.style.removeProperty("--modal-visual-left");
        modal.style.removeProperty("--modal-visual-width");
        modal.style.removeProperty("--modal-visual-height");
    }

    function syncModalToVisualViewport(modal: HTMLElement) {
        const viewport = window.visualViewport;

        if (!mobileViewportQuery.matches || !viewport) {
            clearModalVisualViewport(modal);
            return;
        }

        modal.style.setProperty(
            "--modal-visual-top",
            `${viewport.offsetTop}px`,
        );
        modal.style.setProperty(
            "--modal-visual-left",
            `${viewport.offsetLeft}px`,
        );
        modal.style.setProperty(
            "--modal-visual-width",
            `${viewport.width}px`,
        );
        modal.style.setProperty(
            "--modal-visual-height",
            `${viewport.height}px`,
        );
    }

    function queueOpenModalViewportSync() {
        window.cancelAnimationFrame(viewportSyncFrame);
        viewportSyncFrame = window.requestAnimationFrame(() => {
            document
                .querySelectorAll<HTMLElement>(
                    '.modal.is-open, .modal[data-opening="true"]',
                )
                .forEach(syncModalToVisualViewport);
        });
    }

    window.visualViewport?.addEventListener(
        "resize",
        queueOpenModalViewportSync,
    );
    window.visualViewport?.addEventListener(
        "scroll",
        queueOpenModalViewportSync,
    );

    function openModal(modal: HTMLElement, trigger: HTMLElement) {
        if (
            modal.classList.contains("is-open") ||
            modal.dataset.opening === "true"
        ) {
            return;
        }

        const modalContent = modal.querySelector<HTMLElement>(".modal-content");
        const closeButton =
            modal.querySelector<HTMLButtonElement>(".modal-close");

        modal.dataset.opening = "true";
        document.documentElement.classList.add("modal-active");
        syncModalToVisualViewport(modal);

        requestAnimationFrame(() => {
            requestAnimationFrame(() => {
                if (modal.dataset.opening !== "true") return;

                modal.dataset.opening = "false";
                modal.dataset.closing = "false";
                modal.classList.remove(exitAnimation);
                modal.classList.add("is-open", entranceAnimation);
                modal.setAttribute("aria-hidden", "false");
                openingTriggers.set(modal, trigger);
                modal.dispatchEvent(
                    new CustomEvent("modal:open", { bubbles: true }),
                );

                if (modalContent) {
                    modalContent.scrollTop = 0;
                    modalContent.scrollLeft = 0;
                }

                closeButton?.focus({ preventScroll: true });

                requestAnimationFrame(() => {
                    if (modalContent) modalContent.scrollTop = 0;
                });

                modal.addEventListener("animationend", handleEntranceEnd);
            });
        });

        function handleEntranceEnd(event: AnimationEvent) {
            if (event.target !== modal) return;

            modal.classList.remove(entranceAnimation);
            modal.removeEventListener("animationend", handleEntranceEnd);
        }
    }

    function closeModal(modal: HTMLElement) {
        if (
            !modal.classList.contains("is-open") ||
            modal.dataset.closing === "true"
        ) {
            return;
        }

        modal.dataset.closing = "true";
        modal.classList.remove(entranceAnimation);
        modal.classList.add(exitAnimation);

        let fallbackTimer = window.setTimeout(
            finishClosing,
            animationFallbackDuration,
        );

        function finishClosing() {
            if (modal.dataset.closing !== "true") return;

            window.clearTimeout(fallbackTimer);
            modal.removeEventListener("animationend", handleAnimationEnd);
            modal.classList.remove("is-open", exitAnimation);
            modal.setAttribute("aria-hidden", "true");
            modal.dataset.closing = "false";
            clearModalVisualViewport(modal);

            if (!document.querySelector(".modal.is-open")) {
                document.documentElement.classList.remove("modal-active");
            }

            openingTriggers.get(modal)?.focus({ preventScroll: true });
            openingTriggers.delete(modal);
        }

        function handleAnimationEnd(event: AnimationEvent) {
            if (event.target === modal) finishClosing();
        }

        modal.addEventListener("animationend", handleAnimationEnd);
    }

    modalTriggers.forEach((trigger) => {
        const modalId = trigger.getAttribute("aria-controls");
        const modal = modalId ? document.getElementById(modalId) : null;

        if (!modal) return;

        trigger.addEventListener("click", (event) => {
            event.preventDefault();
            openModal(modal, trigger);
        });

        modal
            .querySelector<HTMLButtonElement>(".modal-close")
            ?.addEventListener("click", () => {
                const nestedModal =
                    modal.querySelector<HTMLElement>(".modal.is-open");
                closeModal(nestedModal ?? modal);
            });
    });

    const requestedModalId = new URLSearchParams(window.location.search).get(
        "open",
    );
    const requestedModal = requestedModalId
        ? document.getElementById(requestedModalId)
        : null;
    const requestedTrigger = requestedModalId
        ? Array.from(modalTriggers).find(
              (trigger) =>
                  trigger.getAttribute("aria-controls") === requestedModalId,
          )
        : null;

    if (requestedModal && requestedTrigger) {
        requestAnimationFrame(() =>
            openModal(requestedModal, requestedTrigger),
        );
    }

    document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;

        const openModals = document.querySelectorAll<HTMLElement>(
            ".modal.is-open",
        );
        const openModalElement = openModals.item(openModals.length - 1);
        if (openModalElement) closeModal(openModalElement);
    });
</script>
