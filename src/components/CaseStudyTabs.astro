<div
    class="case-study-tabs"
    data-case-study-tabs
    data-active-index="0"
    role="tablist"
    aria-label="Filter case studies"
>
    <div class="case-study-tabs__indicator" aria-hidden="true"></div>
    <button
        type="button"
        role="tab"
        aria-selected="true"
        tabindex="0"
        data-category="all"
    >
        All
    </button>
    <button
        type="button"
        role="tab"
        aria-selected="false"
        tabindex="-1"
        data-category="design"
    >
        Design
    </button>
    <button
        type="button"
        role="tab"
        aria-selected="false"
        tabindex="-1"
        data-category="development"
    >
        Development
    </button>
</div>

<script>
    document
        .querySelectorAll<HTMLElement>("[data-case-study-tabs]")
        .forEach((tabList) => {
            if (tabList.dataset.initialized === "true") return;

            const tabs = Array.from(
                tabList.querySelectorAll<HTMLButtonElement>("[role='tab']"),
            );
            tabList.dataset.initialized = "true";

            function selectTab(index: number, moveFocus = false) {
                const selectedTab = tabs[index];
                if (!selectedTab) return;

                tabList.dataset.activeIndex = String(index);

                tabs.forEach((tab, tabIndex) => {
                    const isSelected = tabIndex === index;
                    tab.setAttribute("aria-selected", String(isSelected));
                    tab.tabIndex = isSelected ? 0 : -1;
                });

                if (moveFocus) selectedTab.focus();

                tabList.dispatchEvent(
                    new CustomEvent("case-study-filter-change", {
                        bubbles: true,
                        detail: { category: selectedTab.dataset.category },
                    }),
                );
            }

            tabs.forEach((tab, index) => {
                tab.addEventListener("click", () => selectTab(index));

                tab.addEventListener("keydown", (event) => {
                    let nextIndex = index;

                    if (event.key === "ArrowRight") {
                        nextIndex = (index + 1) % tabs.length;
                    } else if (event.key === "ArrowLeft") {
                        nextIndex = (index - 1 + tabs.length) % tabs.length;
                    } else if (event.key === "Home") {
                        nextIndex = 0;
                    } else if (event.key === "End") {
                        nextIndex = tabs.length - 1;
                    } else {
                        return;
                    }

                    event.preventDefault();
                    selectTab(nextIndex, true);
                });
            });
        });
</script>

<style>
    .case-study-tabs {
        position: relative;
        isolation: isolate;
        box-sizing: border-box;
        display: grid;
        width: min(100%, 520px);
        min-height: 52px;
        margin-inline: auto;
        padding: 4px;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        overflow: hidden;
        border-top: 1px solid var(--white-50);
        border-bottom: 1px solid var(--white-50);
        border-radius: 999px;
        background-color: var(--white-15);
    }

    .case-study-tabs__indicator {
        position: absolute;
        top: 4px;
        bottom: 4px;
        left: 4px;
        z-index: -1;
        width: calc((100% - 8px) / 3);
        border-radius: 999px;
        background-color: #2168f2;
        background-image: radial-gradient(
            ellipse 100% 100% at 50% 0%,
            rgba(255, 255, 255, 0.4) 0%,
            rgba(255, 255, 255, 0) 100%
        );
        box-shadow: 0 3px 6px rgba(36, 36, 36, 0.3);
        transform: translateX(0);
        transition: transform 300ms cubic-bezier(0.2, 0.75, 0.25, 1);
    }

    .case-study-tabs[data-active-index="1"]
        .case-study-tabs__indicator {
        transform: translateX(100%);
    }

    .case-study-tabs[data-active-index="2"]
        .case-study-tabs__indicator {
        transform: translateX(200%);
    }

    .case-study-tabs button {
        appearance: none;
        min-width: 0;
        padding: 8px 12px;
        border: 0;
        background: transparent;
        color: var(--white-75);
        font: inherit;
        font-size: 0.875rem;
        font-weight: 500;
        line-height: 1;
        text-transform: uppercase;
        cursor: pointer;
        transition: color 200ms ease;
    }

    .case-study-tabs button[aria-selected="true"] {
        color: var(--white);
    }

    .case-study-tabs button:focus-visible {
        border-radius: 999px;
        outline: 2px solid var(--white);
        outline-offset: -4px;
    }

    @media only screen and (max-width: 480px) {
        .case-study-tabs {
            min-height: 46px;
        }

        .case-study-tabs button {
            padding-inline: 6px;
            font-size: 0.75rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .case-study-tabs__indicator {
            transition: none;
        }
    }
</style>
