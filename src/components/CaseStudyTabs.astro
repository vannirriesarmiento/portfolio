---
import "../styles/casestudy.css"
---

<div
    class="case-study-tabs"
    data-case-study-tabs
    data-active-index="0"
    role="tablist"
    aria-label="Filter case studies"
>
    <div class="case-study-tabs__indicator" aria-hidden="true"></div>
    <button
        type="button"
        role="tab"
        aria-selected="true"
        tabindex="0"
        data-category="all"
    >
        All
    </button>
    <button
        type="button"
        role="tab"
        aria-selected="false"
        tabindex="-1"
        data-category="design"
    >
        Design
    </button>
    <button
        type="button"
        role="tab"
        aria-selected="false"
        tabindex="-1"
        data-category="development"
    >
        Development
    </button>
</div>

<script>
    document
        .querySelectorAll<HTMLElement>("[data-case-study-tabs]")
        .forEach((tabList) => {
            if (tabList.dataset.initialized === "true") return;

            const tabs = Array.from(
                tabList.querySelectorAll<HTMLButtonElement>("[role='tab']"),
            );
            tabList.dataset.initialized = "true";

            function updateIndicator(tab: HTMLButtonElement) {
                tabList.style.setProperty(
                    "--indicator-left",
                    `${tab.offsetLeft}px`,
                );
                tabList.style.setProperty(
                    "--indicator-width",
                    `${tab.offsetWidth}px`,
                );
            }

            function selectTab(index: number, moveFocus = false) {
                const selectedTab = tabs[index];
                if (!selectedTab) return;

                tabList.dataset.activeIndex = String(index);

                tabs.forEach((tab, tabIndex) => {
                    const isSelected = tabIndex === index;
                    tab.setAttribute("aria-selected", String(isSelected));
                    tab.tabIndex = isSelected ? 0 : -1;
                });

                if (moveFocus) selectedTab.focus();

                updateIndicator(selectedTab);

                tabList.dispatchEvent(
                    new CustomEvent("case-study-filter-change", {
                        bubbles: true,
                        detail: { category: selectedTab.dataset.category },
                    }),
                );
            }

            tabs.forEach((tab, index) => {
                tab.addEventListener("click", () => selectTab(index));

                tab.addEventListener("keydown", (event) => {
                    let nextIndex = index;

                    if (event.key === "ArrowRight") {
                        nextIndex = (index + 1) % tabs.length;
                    } else if (event.key === "ArrowLeft") {
                        nextIndex = (index - 1 + tabs.length) % tabs.length;
                    } else if (event.key === "Home") {
                        nextIndex = 0;
                    } else if (event.key === "End") {
                        nextIndex = tabs.length - 1;
                    } else {
                        return;
                    }

                    event.preventDefault();
                    selectTab(nextIndex, true);
                });
            });

            const resizeObserver = new ResizeObserver(() => {
                const activeIndex = Number(tabList.dataset.activeIndex ?? 0);
                const selectedTab = tabs[activeIndex] ?? tabs[0];

                if (selectedTab) updateIndicator(selectedTab);
            });

            resizeObserver.observe(tabList);

            const initialTab = tabs[0];
            if (initialTab) updateIndicator(initialTab);
        });
</script>
