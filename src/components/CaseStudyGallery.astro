---
import { Image } from "astro:assets";
import CaseStudyLightbox from "./CaseStudyLightbox";

interface Props {
    media: Array<ImageMetadata | string>;
    title: string;
}

type GalleryMedia =
    | {
          type: "image";
          source: ImageMetadata;
          alt: string;
      }
    | {
          type: "video";
          source: string;
          label: string;
      };

import "../styles/casestudy.css";

const { media, title } = Astro.props;
const galleryId = `case-study-gallery-${title
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "")}`;
const videoAssets = import.meta.glob<string>(
    "../assets/img/case-studies/**/*.{mp4,webm}",
    { eager: true, query: "?url", import: "default" },
);
const galleryMedia = media.flatMap<GalleryMedia>((item, index) => {
    if (typeof item !== "string") {
        return [{
            type: "image" as const,
            source: item,
            alt: `${title} gallery image ${index + 1}`,
        }];
    }

    const source = videoAssets[item.replace("../../assets/", "../assets/")];

    return source
        ? [{
            type: "video" as const,
            source,
            label: `${title} gallery video ${index + 1}`,
        }]
        : [];
});
const lightboxSlides = galleryMedia.map((item) => {
    if (item.type === "image") {
        return {
            type: "image" as const,
            src: item.source.src,
            alt: item.alt,
            width: item.source.width,
            height: item.source.height,
        };
    }

    return {
        type: "video" as const,
        sources: [{
            src: item.source,
            type: item.source.endsWith(".mp4") ? "video/mp4" : "video/webm",
        }],
    };
});
---

<div
    class="case-study-gallery-shell"
    data-case-study-gallery
    data-lightbox-id={galleryId}
>
    <section class="splide case-study-gallery" aria-label={`${title} gallery`}>
        <div class="splide__track">
            <ul class="splide__list">
                {
                    galleryMedia.map((item, index) => {
                        if (item.type === "image") {
                            return (
                                <li class="splide__slide">
                                <button
                                    type="button"
                                    class="case-study-gallery__open"
                                    data-lightbox-index={index}
                                    aria-haspopup="dialog"
                                    aria-label={`Open ${item.alt} in fullscreen`}
                                >
                                    <Image
                                        src={item.source}
                                        alt={item.alt}
                                        widths={[320, 480, 640, 800, 960, 1280, 1600]}
                                        sizes="(max-width: 767px) calc(100vw - 32px), 800px"
                                        quality={90}
                                        loading={index === 0 ? "eager" : "lazy"}
                                    />
                                </button>
                                </li>
                            );
                        }

                        return (
                            <li class="splide__slide">
                                <button
                                    type="button"
                                    class="case-study-gallery__open"
                                    data-lightbox-index={index}
                                    aria-haspopup="dialog"
                                    aria-label={`Open ${item.label} in fullscreen`}
                                >
                                    <video
                                        src={item.source}
                                        aria-label={item.label}
                                        autoplay
                                        muted
                                        loop
                                        playsinline
                                        preload="metadata"
                                    />
                                </button>
                            </li>
                        );
                    })
                }
            </ul>
        </div>
    </section>

    <CaseStudyLightbox
        client:load
        galleryId={galleryId}
        title={title}
        slides={lightboxSlides}
    />
</div>

<script>
    import Splide from "@splidejs/splide";

    document
        .querySelectorAll<HTMLElement>("[data-case-study-gallery]")
        .forEach((root) => {
            if (root.dataset.initialized === "true") return;

            const gallery = root.querySelector<HTMLElement>(
                ".case-study-gallery",
            );
            const galleryId = root.dataset.lightboxId;

            if (!gallery || !galleryId) return;

            root.dataset.initialized = "true";

            new Splide(gallery, {
                type: "loop",
                perPage: 1,
                gap: "16px",
                drag: true,
                pagination: false,
                arrows: false,
                speed: 550,
                autoplay: true,
                interval: 3000,
                pauseOnHover: true,
                pauseOnFocus: true,
            }).mount();

            gallery.addEventListener("click", (event) => {
                const target = event.target;
                if (!(target instanceof Element)) return;

                const trigger = target.closest<HTMLButtonElement>(
                    "[data-lightbox-index]",
                );
                if (!trigger || !gallery.contains(trigger)) return;

                const index = Number(trigger.dataset.lightboxIndex);
                if (!Number.isInteger(index)) return;

                window.dispatchEvent(
                    new CustomEvent("case-study-lightbox:open", {
                        detail: { galleryId, index, trigger },
                    }),
                );
            });
        });
</script>
