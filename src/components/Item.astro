---
import Image from "astro/components/Image.astro";
import Modal from "./Modal.astro";

const {
    className,
    imgData = [],
    cursorText,
    href,
    actionTarget,
    movable = false,
    blockedMoveMessage,
    storageBlockedMessage,
    storageTarget = false,
} = Astro.props;
const hasAction = Boolean(actionTarget);
const hasModal = Boolean(
    cursorText && !href && !hasAction && className !== "lamp",
);
const hasLink = Boolean(href || (cursorText && !hasModal && !hasAction));
const isExternalLink =
    typeof href === "string" && /^https?:\/\//.test(href);
const isButton = hasModal || hasAction || storageTarget;
const Element = isButton ? "button" : hasLink ? "a" : "div";
const modalId = `${className.trim().replace(/\s+/g, "-")}-modal`;
---

<Element
    class={`item ${className}`}
    href={href ?? (!hasModal && !hasAction && cursorText ? `#${className}` : undefined)}
    target={isExternalLink ? "_blank" : undefined}
    rel={isExternalLink ? "noopener noreferrer" : undefined}
    type={isButton ? "button" : undefined}
    aria-haspopup={hasModal ? "dialog" : undefined}
    aria-controls={hasModal ? modalId : actionTarget}
    aria-expanded={hasAction ? "false" : undefined}
    data-desk-movable={movable ? "" : undefined}
    data-desk-move-blocked={blockedMoveMessage ?? undefined}
    data-desk-storage-blocked={storageBlockedMessage ?? undefined}
    data-desk-storage-target={storageTarget ? "" : undefined}
>
    {cursorText && <div class="cursor">{cursorText}</div>}
    {
        imgData.map(
            (img: { src: ImageMetadata; alt: string; class?: string }) => (
                <Image src={img.src} alt={img.alt} class={img.class || ""} />
            ),
        )
    }
</Element>
{hasModal && <Modal id={modalId} title={cursorText}><slot /></Modal>}
