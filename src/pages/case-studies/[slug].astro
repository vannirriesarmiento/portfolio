---
import { Image } from "astro:assets";
import { getCollection, render, type CollectionEntry } from "astro:content";

import Desk from "../../components/Desk.astro";
import SafariViewportFix from "../../components/SafariViewportFix.astro";
import CaseStudyGallery from "../../components/CaseStudyGallery.astro";
import CaseStudyLightbox from "../../components/CaseStudyLightbox";
import Toast from "../../components/Toast.astro";

import "../../styles/global.css";
import "../../styles/casestudy.css";

export async function getStaticPaths() {
    const caseStudies = await getCollection(
        "caseStudies",
        ({ data }) => !data.draft,
    );

    return caseStudies.map((study) => ({
        params: { slug: study.id },
        props: { study },
    }));
}

interface Props {
    study: CollectionEntry<"caseStudies">;
}

const { study } = Astro.props;
const { Content, headings } = await render(study);
const { data } = study;
const projectLogo = data.logo;
const galleryMedia = data.gallery;
const tableOfContents = headings.filter(({ depth }) => depth === 2);
const contentLightboxId = `case-study-content-${study.id
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "")}`;
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
    ? import.meta.env.BASE_URL
    : `${import.meta.env.BASE_URL}/`;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/webp" href={`${baseUrl}favicon.webp`} />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1, viewport-fit=cover"
        />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={data.description} />
        <title>Case Studies | {data.title}</title>
    </head>
    <body class="case-study-page">
        <SafariViewportFix />
        <main>
        <Desk />
            <div class="wrapping">
                <div class="overlay">
                    <button
                        type="button"
                        class="modal-close"
                        aria-label="Back"
                        data-case-study-back
                    >
                        <span class="material-symbols-outlined"style="font-size: 1.25rem;">
                            arrow_back_ios
                        </span>
                    </button>

                    <div class="casestudy-content">
                        <article class="casestudy-body">
                            <header class="case-study-hero">
                                <div class="case-study-hero__identity">
                                    <Image
                                        src={projectLogo}
                                        alt={`${data.title} logo`}
                                        width={72}
                                        height={72}
                                        fit="contain"
                                        loading="eager"
                                    />
                                    <h1>{data.title}</h1>
                                </div>
                                <p class="case-study-description">
                                    {data.description}
                                </p>
                            </header>

                            <dl class="case-study-facts">
                                <div>
                                    <dt>Role</dt>
                                    <dd>{data.role}</dd>
                                </div>
                                <div>
                                    <dt>Industry</dt>
                                    <dd>{data.industry}</dd>
                                </div>
                                <div>
                                    <dt>Status</dt>
                                    <dd>{data.status}</dd>
                                </div>
                                <div>
                                    <dt>Tools</dt>
                                    <dd>{data.tools}</dd>
                                </div>
                            </dl>

                            {
                                galleryMedia.length > 0 && (
                                    <CaseStudyGallery
                                        media={galleryMedia}
                                        title={data.title}
                                    />
                                )
                            }

                            <div class="case-study-content">
                                {
                                    tableOfContents.length > 0 && (
                                        <nav
                                            class="case-study-nav"
                                            aria-label="Case study sections"
                                            data-case-study-nav
                                        >
                                            {tableOfContents.map(
                                                (heading, index) => (
                                                    <a
                                                        href={`#${heading.slug}`}
                                                        aria-current={
                                                            index === 0
                                                                ? "location"
                                                                : undefined
                                                        }
                                                    >
                                                        {heading.text}
                                                    </a>
                                                ),
                                            )}
                                        </nav>
                                    )
                                }
                                <div
                                    class="case-study-copy"
                                    data-content-lightbox-id={contentLightboxId}
                                >
                                    <Content />
                                </div>
                                <CaseStudyLightbox
                                    client:load
                                    galleryId={contentLightboxId}
                                    contentRootId={contentLightboxId}
                                    title={`${data.title} content`}
                                    slides={[]}
                                />
                            </div>
                        </article>
                    </div>
                </div>
            </div>
        </main>
        <Toast />
        <script>
            const baseUrl = import.meta.env.BASE_URL.endsWith("/")
                ? import.meta.env.BASE_URL
                : `${import.meta.env.BASE_URL}/`;
            const backButton = document.querySelector<HTMLButtonElement>(
                "[data-case-study-back]",
            );

            backButton?.addEventListener("click", () => {
                let cameFromHome = false;

                try {
                    const previousPage = new URL(document.referrer);
                    cameFromHome =
                        previousPage.origin === window.location.origin &&
                        (previousPage.pathname === baseUrl ||
                            previousPage.pathname === `${baseUrl}index.html`);
                } catch {
                    // No usable referrer; open the case studies modal directly.
                }

                if (cameFromHome && window.history.length > 1) {
                    window.history.back();
                    return;
                }

                window.location.href = `${baseUrl}?open=mac-modal#case-studies`;
            });

            const caseStudyNav =
                document.querySelector<HTMLElement>("[data-case-study-nav]");

            if (caseStudyNav) {
                const nav = caseStudyNav;
                const navLinks = Array.from(
                    nav.querySelectorAll<HTMLAnchorElement>(
                        'a[href^="#"]',
                    ),
                );
                const sectionLinks = navLinks.flatMap((link) => {
                    const sectionId = decodeURIComponent(link.hash.slice(1));
                    const section = document.getElementById(sectionId);

                    return section ? [{ link, section }] : [];
                });
                const scrollContainer =
                    nav.closest<HTMLElement>(".casestudy-content");
                const reduceMotion = window.matchMedia(
                    "(prefers-reduced-motion: reduce)",
                );
                let activeLink: HTMLAnchorElement | null = null;
                let scrollFrame = 0;

                function setActiveLink(link: HTMLAnchorElement) {
                    if (activeLink === link) return;

                    activeLink = link;
                    navLinks.forEach((navLink) => {
                        if (navLink === link) {
                            navLink.setAttribute("aria-current", "location");
                        } else {
                            navLink.removeAttribute("aria-current");
                        }
                    });

                    const centeredPosition =
                        link.offsetLeft -
                        (nav.clientWidth - link.offsetWidth) / 2;

                    nav.scrollTo({
                        left: Math.max(0, centeredPosition),
                        behavior: reduceMotion.matches ? "auto" : "smooth",
                    });
                }

                function updateActiveLink() {
                    if (sectionLinks.length === 0) return;

                    const readingLine =
                        nav.getBoundingClientRect().bottom + 24;
                    let current = sectionLinks.reduce((nearest, item) =>
                        item.section.getBoundingClientRect().top <
                        nearest.section.getBoundingClientRect().top
                            ? item
                            : nearest,
                    );
                    let nearestTop = Number.NEGATIVE_INFINITY;

                    for (const item of sectionLinks) {
                        const sectionTop =
                            item.section.getBoundingClientRect().top;

                        if (
                            sectionTop <= readingLine &&
                            sectionTop > nearestTop
                        ) {
                            current = item;
                            nearestTop = sectionTop;
                        }
                    }

                    if (
                        scrollContainer &&
                        scrollContainer.scrollTop +
                            scrollContainer.clientHeight >=
                            scrollContainer.scrollHeight - 2
                    ) {
                        current = sectionLinks.reduce((last, item) =>
                            item.section.getBoundingClientRect().top >
                            last.section.getBoundingClientRect().top
                                ? item
                                : last,
                        );
                    }

                    setActiveLink(current.link);
                }

                function queueActiveLinkUpdate() {
                    if (scrollFrame) return;

                    scrollFrame = window.requestAnimationFrame(() => {
                        scrollFrame = 0;
                        updateActiveLink();
                    });
                }

                navLinks.forEach((link) => {
                    link.addEventListener("click", () => setActiveLink(link));
                });
                scrollContainer?.addEventListener(
                    "scroll",
                    queueActiveLinkUpdate,
                    { passive: true },
                );
                window.addEventListener("resize", queueActiveLinkUpdate, {
                    passive: true,
                });
                updateActiveLink();
            }
        </script>
    </body>
</html>
