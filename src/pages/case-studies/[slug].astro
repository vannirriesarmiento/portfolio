---
import { Image } from "astro:assets";
import { getCollection, render, type CollectionEntry } from "astro:content";
import "animate.css";
import "../../styles/global.css";
import CaseStudyGallery from "../../components/CaseStudyGallery.astro";

export async function getStaticPaths() {
    const caseStudies = await getCollection(
        "caseStudies",
        ({ data }) => !data.draft,
    );

    return caseStudies.map((study) => ({
        params: { slug: study.id },
        props: { study },
    }));
}

interface Props {
    study: CollectionEntry<"caseStudies">;
}

const { study } = Astro.props;
const { Content } = await render(study);
const { data } = study;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/webp" href="/favicon.webp" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={data.description} />
        <title>{data.title} | Van's Deskfolio</title>
    </head>
    <body class="case-study-page">
        <main
            class="case-study-overlay animate__animated animate__fadeIn"
            data-case-study-page
        >
            <article class="case-study-detail">
                <a
                    class="case-study-back"
                    href="/?open=mac-modal#case-studies"
                    data-case-study-back
                >
                    <span class="material-symbols-outlined" aria-hidden="true">
                        arrow_back
                    </span>
                    Back to case studies
                </a>

                <header class="case-study-hero">
                    <div class="case-study-hero__logo">
                        <Image
                            src={data.logo}
                            alt={`${data.title} logo`}
                            width={144}
                            height={144}
                            fit="contain"
                            loading="eager"
                        />
                    </div>
                    <div>
                        <p class="case-study-eyebrow">
                            {data.category} · {data.readDuration} min read
                        </p>
                        <h1>{data.title}</h1>
                        <p class="case-study-description">{data.description}</p>
                    </div>
                </header>

                <dl class="case-study-facts">
                    <div>
                        <dt>Role</dt>
                        <dd>{data.role}</dd>
                    </div>
                    <div>
                        <dt>Industry</dt>
                        <dd>{data.industry}</dd>
                    </div>
                    <div>
                        <dt>Status</dt>
                        <dd>{data.status}</dd>
                    </div>
                    <div>
                        <dt>Tools</dt>
                        <dd>{data.tools}</dd>
                    </div>
                </dl>

                {
                    data.gallery.length > 0 && (
                        <CaseStudyGallery
                            images={data.gallery}
                            title={data.title}
                        />
                    )
                }

                <div class="case-study-body">
                    <Content />
                </div>
            </article>
        </main>

        <script>
            const page =
                document.querySelector<HTMLElement>("[data-case-study-page]");
            const backButton = document.querySelector<HTMLAnchorElement>(
                "[data-case-study-back]",
            );

            backButton?.addEventListener("click", (event) => {
                if (!page) return;

                event.preventDefault();
                const fallbackUrl = backButton.href;
                const referrer = document.referrer
                    ? new URL(document.referrer)
                    : null;
                const canReturnToList =
                    referrer?.origin === window.location.origin &&
                    referrer.pathname === "/";
                let hasLeft = false;

                page.classList.remove("animate__fadeIn");
                page.classList.add("animate__fadeOut");

                const leave = () => {
                    if (hasLeft) return;
                    hasLeft = true;

                    if (canReturnToList) {
                        window.history.back();
                    } else {
                        window.location.assign(fallbackUrl);
                    }
                };

                page.addEventListener("animationend", leave, { once: true });
                window.setTimeout(leave, 450);
            });
        </script>
    </body>
</html>

<style is:global>
    body.case-study-page {
        min-height: 100dvh;
        overflow: auto;
    }

    .case-study-overlay {
        --animate-duration: 350ms;
        box-sizing: border-box;
        display: flex;
        width: 100%;
        min-height: 100dvh;
        height: auto;
        padding: 24px;
        background: var(--black-50);
        color: var(--white);
        backdrop-filter: blur(24px);
    }

    .case-study-detail {
        box-sizing: border-box;
        width: min(100%, 1040px);
        margin: auto;
        padding: clamp(20px, 4vw, 56px);
        border-top: 1px solid var(--white-50);
        border-bottom: 1px solid var(--white-50);
        border-radius: 24px;
        background: var(--white-15);
        box-shadow: 2px 8px 32px rgba(0, 0, 0, 0.25);
        backdrop-filter: blur(24px);
    }

    .case-study-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: clamp(32px, 6vw, 64px);
        color: var(--white);
        font-size: 0.875rem;
        font-weight: 700;
        text-decoration: none;
        text-transform: uppercase;
    }

    .case-study-back .material-symbols-outlined {
        transition: transform 180ms ease;
    }

    .case-study-back:hover .material-symbols-outlined {
        transform: translateX(-4px);
    }

    .case-study-back:focus-visible {
        outline: 2px solid var(--white);
        outline-offset: 6px;
        border-radius: 4px;
    }

    .case-study-hero {
        display: grid;
        grid-template-columns: 144px minmax(0, 1fr);
        align-items: center;
        gap: clamp(24px, 5vw, 56px);
    }

    .case-study-hero__logo {
        display: grid;
        width: 144px;
        height: 144px;
        place-items: center;
        overflow: hidden;
        border-radius: 20px;
        background: var(--white-15);
    }

    .case-study-hero__logo img {
        box-sizing: border-box;
        width: 100%;
        height: 100%;
        padding: 20px;
        object-fit: contain;
    }

    .case-study-eyebrow {
        margin-bottom: 10px;
        color: var(--white-75);
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .case-study-hero h1 {
        display: block;
        margin: 0;
        color: var(--white);
        font-size: clamp(2.25rem, 7vw, 4.75rem);
        font-weight: 500;
        line-height: 0.95;
    }

    .case-study-description {
        max-width: 720px;
        margin-top: 20px;
        color: var(--white-75);
        font-size: clamp(1rem, 2vw, 1.2rem);
        line-height: 1.55;
    }

    .case-study-facts {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1px;
        margin: clamp(40px, 7vw, 72px) 0;
        overflow: hidden;
        border-radius: 16px;
        background: var(--white-20);
    }

    .case-study-facts div {
        min-width: 0;
        padding: 20px;
        background: rgba(0, 0, 0, 0.14);
    }

    .case-study-facts dt {
        margin-bottom: 8px;
        color: var(--white-75);
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
    }

    .case-study-facts dd {
        margin: 0;
        overflow-wrap: anywhere;
        font-size: 0.95rem;
        line-height: 1.35;
    }

    .case-study-body {
        width: min(100%, 760px);
        margin: clamp(48px, 8vw, 88px) auto 0;
        color: var(--white-75);
        font-size: 1.05rem;
        line-height: 1.75;
    }

    .case-study-body > :first-child {
        margin-top: 0;
    }

    .case-study-body > :last-child {
        margin-bottom: 0;
    }

    .case-study-body h2,
    .case-study-body h3 {
        margin: 2em 0 0.65em;
        color: var(--white);
        font-weight: 500;
        line-height: 1.15;
    }

    .case-study-body h2 {
        font-size: clamp(1.75rem, 4vw, 2.5rem);
    }

    .case-study-body h3 {
        font-size: 1.4rem;
    }

    .case-study-body p,
    .case-study-body ul,
    .case-study-body ol,
    .case-study-body blockquote {
        margin: 0 0 1.4em;
    }

    .case-study-body a {
        color: var(--light-blue);
    }

    .case-study-body img {
        height: auto;
        margin: 32px 0;
        border-radius: 16px;
    }

    .case-study-body blockquote {
        padding: 4px 0 4px 20px;
        border-left: 3px solid var(--white-50);
        color: var(--white);
    }

    @media (max-width: 767px) {
        .case-study-overlay {
            padding: 0;
        }

        .case-study-detail {
            min-height: 100dvh;
            padding: 24px;
            border: 0;
            border-radius: 0;
            background: transparent;
            box-shadow: none;
        }

        .case-study-back {
            margin-bottom: 40px;
        }

        .case-study-hero {
            grid-template-columns: 72px minmax(0, 1fr);
            gap: 18px;
        }

        .case-study-hero__logo {
            width: 72px;
            height: 72px;
            border-radius: 14px;
        }

        .case-study-hero__logo img {
            padding: 10px;
        }

        .case-study-description {
            grid-column: 1 / -1;
        }

        .case-study-facts {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .case-study-facts div {
            padding: 16px;
        }

        .case-study-body {
            font-size: 1rem;
            line-height: 1.65;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .case-study-overlay {
            animation: none !important;
        }

        .case-study-back .material-symbols-outlined {
            transition: none;
        }
    }
</style>
