---
import "../styles/global.css";


import Desk from "../components/Desk.astro";
import Splash from "../components/Splash.astro";
import Toast from "../components/Toast.astro";

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const openGraphImage = Astro.site
	? new URL(`${baseUrl}img/seo%20image.webp`, Astro.site).href
	: `${baseUrl}img/seo%20image.webp`;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/webp" href={`${baseUrl}favicon.webp`} />
		<link rel="icon" href={`${baseUrl}favicon.webp`} />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1, viewport-fit=cover"
		/>
		<meta name="generator" content={Astro.generator} />
		<meta property="og:image" content={openGraphImage} />
		<meta property="og:image:alt" content="Van's Deskfolio" />

		<title>Van's Deskfolio</title>
	</head>
	<body>
		<main>
			<div class="wrapping">
				<h1>Van's Deskfolio</h1>
				<Splash />
				<Desk />
			</div>
		</main>
		<Toast />
	</body>
</html>
